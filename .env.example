# Copy this file to .env and fill in your keys:  cp .env.example .env
# Never commit .env (it's already in .gitignore).

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# The chat provider used by default: anthropic or openai
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_MODEL=gpt-6-luna

# Embeddings: openai (text-embedding-3-small) or local (free, runs on your machine)
EMBED_PROVIDER=openai
OPENAI_EMBED_MODEL=text-embedding-3-small
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5

QDRANT_URL=http://localhost:6333
DATABASE_URL=postgresql://larkspan:larkspan@localhost:5432/larkspan
